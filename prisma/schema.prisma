generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum FeeStatus {
  PENDING
  PARTIAL
  PAID
  WAIVED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  ONLINE_PORTAL
  CHEQUE
}

model Student {
  id           String        @id @default(cuid())
  name         String
  studentNo    String        @unique
  program      String
  batch        String?
  createdAt    DateTime      @default(now())
  fees         MonthlyFee[]
  payments     FeePayment[]
  concessions  Concession[]
}

model FeeStructure {
  id            String             @id @default(cuid())
  name          String
  program       String
  batch         String?
  monthlyAmount Decimal            @db.Decimal(12, 2)
  active        Boolean            @default(true)
  items         FeeStructureItem[]
}

model FeeStructureItem {
  id             String       @id @default(cuid())
  feeStructureId String
  name           String
  amount         Decimal      @db.Decimal(12, 2)
  feeStructure   FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)
}

model MonthlyFee {
  id               String              @id @default(cuid())
  studentId        String
  month            DateTime
  originalAmount   Decimal             @db.Decimal(12, 2)
  concessionAmount Decimal             @default(0) @db.Decimal(12, 2)
  payableAmount    Decimal             @db.Decimal(12, 2)
  paidAmount       Decimal             @default(0) @db.Decimal(12, 2)
  status           FeeStatus           @default(PENDING)
  student          Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  allocations      PaymentAllocation[]

  @@unique([studentId, month])
  @@index([month, status])
}

model Concession {
  id         String   @id @default(cuid())
  studentId  String
  month      DateTime
  type       String
  percentage Decimal? @db.Decimal(5, 2)
  amount     Decimal  @db.Decimal(12, 2)
  note       String?
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model FeePayment {
  id          String              @id @default(cuid())
  studentId   String
  paidAt      DateTime            @default(now())
  amount      Decimal             @db.Decimal(12, 2)
  method      PaymentMethod
  reference   String?
  note        String?
  student     Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  allocations PaymentAllocation[]
}

model PaymentAllocation {
  id           String     @id @default(cuid())
  paymentId    String
  monthlyFeeId String
  amount       Decimal    @db.Decimal(12, 2)
  payment      FeePayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  monthlyFee   MonthlyFee @relation(fields: [monthlyFeeId], references: [id], onDelete: Cascade)

  @@unique([paymentId, monthlyFeeId])
}

model Employee {
  id          String       @id @default(cuid())
  name        String
  employeeNo  String       @unique
  department  String
  designation String
  salary      Decimal      @db.Decimal(12, 2)
  attendances Attendance[]
  salaries    Salary[]
}

model Attendance {
  id         String    @id @default(cuid())
  employeeId String
  date       DateTime
  inTime     DateTime?
  outTime    DateTime?
  status     String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
}

model Salary {
  id          String   @id @default(cuid())
  employeeId  String
  month       DateTime
  basic       Decimal  @db.Decimal(12, 2)
  allowances  Decimal  @default(0) @db.Decimal(12, 2)
  deductions  Decimal  @default(0) @db.Decimal(12, 2)
  net         Decimal  @db.Decimal(12, 2)
  paid        Boolean  @default(false)
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, month])
}

model Expense {
  id          String   @id @default(cuid())
  date        DateTime @default(now())
  category    String
  amount      Decimal  @db.Decimal(12, 2)
  description String?
}

model Lecture {
  id          String            @id @default(cuid())
  title       String
  subject     String
  program     String
  batch       String?
  lectureDate DateTime
  teacherId   String?
  materials   LectureMaterial[]
}

model LectureMaterial {
  id        String  @id @default(cuid())
  lectureId String
  type      String
  title     String
  url       String
  lecture   Lecture @relation(fields: [lectureId], references: [id], onDelete: Cascade)
}
